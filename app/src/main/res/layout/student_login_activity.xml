<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent" android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.tale.qa.student.Student_Login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/linearLayout">


    </LinearLayout>

    <Button
        android:id="@+id/student_login_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="173dp"
        android:layout_marginTop="362dp"
        android:layout_marginEnd="134dp"
        android:text="Sign In" />

    <TextView
        android:id="@+id/reg_textView"
        android:layout_width="188dp"
        android:layout_height="37dp"
        android:layout_below="@+id/student_login_btn"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="127dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="112dp"
        android:text="Haven&apos;t yet registered?"
        android:textSize="15dp"
        android:textStyle="bold|italic" />

    <EditText
        android:id="@+id/retrieve_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="269dp"
        android:ems="10"
        android:hint="ID NUMBER"
        android:inputType="number" />

</RelativeLayout>
